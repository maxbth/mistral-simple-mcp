MISTRAL_API_KEY=your-api-key-here
# MISTRAL_DEFAULT_MODEL=mistral-medium-latest    # or mistral-small-latest, mistral-large-latest
# MISTRAL_TIMEOUT_MS=60000
# MISTRAL_TRANSCRIPTION_MODEL=voxtral-mini-latest
# MISTRAL_TRANSCRIBE_TIMEOUT_MS=300000                 # audio is processed by duration, so its own deadline
# MISTRAL_AUDIO_ROOTS=                                 # absolute dirs mistral_transcribe may read; empty disables filePath
# MISTRAL_AUDIO_MAX_BYTES=104857600                    # 100 MiB cap on one local audio file
# MISTRAL_BASE_URL=
# MCP_TRANSPORT=http
# MCP_HOST=127.0.0.1
# MCP_PORT=3000
# MCP_HTTP_PATH=/mcp
# MCP_AUTH_TOKEN=
# MCP_ALLOWED_ORIGINS=
# SCHEMA_TIMEOUT_MS=2000                 # wall-clock budget for compiling/validating one schema
